---
import type { Project } from '../data/projects';

interface Props {
  project: Project;
}

const { project } = Astro.props;

const statusColorMap = {
  'Active': 'text-emerald-500 bg-emerald-500/10 border-emerald-500/20',
  'Shipped': 'text-blue-500 bg-blue-500/10 border-blue-500/20',
  'In Progress': 'text-amber-500 bg-amber-500/10 border-amber-500/20',
  'Experiment': 'text-purple-500 bg-purple-500/10 border-purple-500/20',
};
---

<div class="group relative rounded-xl border border-border-light dark:border-border-dark bg-surface-light/40 dark:bg-surface-dark/40 p-5 sm:p-6 transition-all duration-200 hover:border-gray-400 dark:hover:border-gray-600 hover:bg-surface-light dark:hover:bg-surface-dark">
  <div class="flex items-start justify-between gap-4">
    <div class="space-y-1.5">
      <div class="flex items-center gap-2.5 flex-wrap">
        <h3 class="font-medium text-base text-primary-light dark:text-primary-dark tracking-tight">
          {project.title}
        </h3>
        {project.status && (
          <span class={`inline-flex items-center px-2 py-0.5 rounded-full text-xs font-mono font-medium border ${statusColorMap[project.status] || 'text-gray-500'}`}>
            {project.status}
          </span>
        )}
      </div>
      <p class="text-sm text-muted-light dark:text-muted-dark leading-relaxed">
        {project.description}
      </p>
    </div>

    <!-- External Link Icons -->
    <div class="flex items-center gap-2 shrink-0 pt-0.5">
      {project.githubUrl && (
        <a
          href={project.githubUrl}
          target="_blank"
          rel="noopener noreferrer"
          aria-label={`View ${project.title} on GitHub`}
          class="p-1.5 text-muted-light dark:text-muted-dark hover:text-primary-light dark:hover:text-primary-dark transition-colors"
        >
          <svg class="w-4 h-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <path d="M9 19c-5 1.5-5-2.5-7-3m14 6v-3.87a3.37 3.37 0 0 0-.94-2.61c3.14-.35 6.44-1.54 6.44-7A5.44 5.44 0 0 0 20 4.77 5.07 5.07 0 0 0 19.91 1S18.73.65 16 2.48a13.38 13.38 0 0 0-7 0C6.27.65 5.09 1 5.09 1A5.07 5.07 0 0 0 5 4.77a5.44 5.44 0 0 0-1.5 3.78c0 5.42 3.3 6.61 6.44 7A3.37 3.37 0 0 0 9 18.13V22"></path>
          </svg>
        </a>
      )}
      {project.liveUrl && (
        <a
          href={project.liveUrl}
          target="_blank"
          rel="noopener noreferrer"
          aria-label={`Visit ${project.title} live demo`}
          class="p-1.5 text-muted-light dark:text-muted-dark hover:text-primary-light dark:hover:text-primary-dark transition-colors"
        >
          <svg class="w-4 h-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <path d="M18 13v6a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h6"></path>
            <polyline points="15 3 21 3 21 9"></polyline>
            <line x1="10" y1="14" x2="21" y2="3"></line>
          </svg>
        </a>
      )}
    </div>
  </div>

  <!-- Tech tags -->
  <div class="mt-4 flex flex-wrap gap-1.5">
    {project.tags.map((tag) => (
      <span class="text-xs font-mono text-muted-light dark:text-muted-dark px-2 py-0.5 rounded bg-surface-light dark:bg-surface-dark border border-border-light dark:border-border-dark">
        {tag}
      </span>
    ))}
  </div>
</div>
