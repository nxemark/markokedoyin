---
import '../styles/global.css';
import ThemeToggle from '../components/ThemeToggle.astro';
import ArrowUpRight from '../components/ArrowUpRight.astro';
import { personalInfo } from '../data/projects';

interface Props {
  title?: string;
  description?: string;
}

const {
  title = `${personalInfo.name} — Portfolio`,
  description = personalInfo.bio
} = Astro.props;

const canonicalURL = new URL(Astro.url.pathname, Astro.site);
---

<!DOCTYPE html>
<html lang="en" class="scroll-smooth">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="canonical" href={canonicalURL} />
    
    <!-- Primary Meta Tags -->
    <title>{title}</title>
    <meta name="title" content={title} />
    <meta name="description" content={description} />
    <meta name="author" content={personalInfo.name} />

    <!-- Open Graph / Facebook -->
    <meta property="og:type" content="website" />
    <meta property="og:url" content={Astro.url} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />

    <!-- Twitter -->
    <meta property="twitter:card" content="summary_large_image" />
    <meta property="twitter:url" content={Astro.url} />
    <meta property="twitter:title" content={title} />
    <meta property="twitter:description" content={description} />

    <!-- Preconnect fonts -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&family=JetBrains+Mono:wght@400;500&display=swap" rel="stylesheet" />

    <!-- Dark mode inline script to prevent flash of unstyled content (FOUC) -->
    <script is:inline>
      const getThemePreference = () => {
        try {
          const saved = localStorage.getItem('theme');
          if (saved === 'dark' || saved === 'light') return saved;
        } catch {}
        return 'light';
      };
      const isDark = getThemePreference() === 'dark';
      document.documentElement.classList[isDark ? 'add' : 'remove']('dark');
    </script>
  </head>
  <body>
    <a class="skip-link" href="#main">Skip to content</a>
    <div class="site-shell">
      
      <!-- Top Navigation -->
      <header class="site-header">
        <a class="wordmark" href="/" aria-label="Mark Okedoyin home">mo<ArrowUpRight class="wordmark-arrow" /></a>
        <div class="header-links">
          <nav aria-label="Main navigation">
            <a href="#about">About</a>
            <a href="#connect">Connect</a>
          </nav>
          <ThemeToggle />
        </div>
      </header>

      <!-- Main Slot -->
      <main id="main">
        <slot />
      </main>

      <!-- Footer -->
      <footer class="site-footer">
        <p>© {new Date().getFullYear()} {personalInfo.name}</p>
        <p>Built with care. Kept simple.</p>
      </footer>
    </div>
  </body>
</html>
