---
import BaseLayout from '../layouts/BaseLayout.astro';
import ProjectCard from '../components/ProjectCard.astro';
import { personalInfo, projects } from '../data/projects';
---

<BaseLayout>
  <!-- Hero Section -->
  <section class="space-y-6">
    <div class="space-y-2">
      <h1 class="text-3xl sm:text-4xl font-semibold tracking-tight text-primary-light dark:text-primary-dark">
        {personalInfo.name}
      </h1>
      <p class="font-mono text-sm text-muted-light dark:text-muted-dark">
        {personalInfo.title}
      </p>
    </div>

    <p class="text-base sm:text-lg text-muted-light dark:text-muted-dark leading-relaxed">
      {personalInfo.bio}
    </p>

    <div class="flex items-center gap-3 pt-1">
      <a
        href="#connect"
        class="inline-flex items-center gap-2 px-4 py-2 rounded-lg bg-primary-light dark:bg-primary-dark text-background-light dark:text-background-dark text-xs font-mono font-medium hover:opacity-90 transition-opacity"
      >
        <span>Get in touch</span>
        <svg class="w-3.5 h-3.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
          <path d="M5 12h14"></path>
          <path d="m12 5 7 7-7 7"></path>
        </svg>
      </a>
      <a
        href="#projects"
        class="inline-flex items-center gap-2 px-4 py-2 rounded-lg border border-border-light dark:border-border-dark text-primary-light dark:text-primary-dark text-xs font-mono font-medium hover:bg-surface-light dark:hover:bg-surface-dark transition-colors"
      >
        <span>View work</span>
      </a>
    </div>
  </section>

  <!-- Projects Section -->
  <section id="projects" class="pt-16 sm:pt-20 space-y-6">
    <div class="flex items-baseline justify-between border-b border-border-light dark:border-border-dark pb-3">
      <h2 class="font-mono text-xs uppercase tracking-wider text-muted-light dark:text-muted-dark font-medium">
        Works & Experiments
      </h2>
      <span class="text-xs font-mono text-muted-light dark:text-muted-dark">
        {projects.length} {projects.length === 1 ? 'item' : 'items'}
      </span>
    </div>

    <div class="grid grid-cols-1 gap-4">
      {projects.map((project) => (
        <ProjectCard project={project} />
      ))}
    </div>
  </section>

  <!-- About / Current Focus Section -->
  <section id="about" class="pt-16 sm:pt-20 space-y-4">
    <div class="border-b border-border-light dark:border-border-dark pb-3">
      <h2 class="font-mono text-xs uppercase tracking-wider text-muted-light dark:text-muted-dark font-medium">
        Current Focus
      </h2>
    </div>

    <div class="rounded-xl border border-border-light dark:border-border-dark bg-surface-light/30 dark:bg-surface-dark/30 p-5 sm:p-6 space-y-3">
      <div class="flex items-center gap-2 text-xs font-mono text-emerald-500 font-medium">
        <span class="w-2 h-2 rounded-full bg-emerald-500"></span>
        <span>What I'm currently exploring</span>
      </div>
      <p class="text-sm text-muted-light dark:text-muted-dark leading-relaxed">
        {personalInfo.currentlyLearning}
      </p>
    </div>
  </section>

  <!-- Connect Section -->
  <section id="connect" class="pt-16 sm:pt-20 space-y-4">
    <div class="border-b border-border-light dark:border-border-dark pb-3">
      <h2 class="font-mono text-xs uppercase tracking-wider text-muted-light dark:text-muted-dark font-medium">
        Connect & Inquiries
      </h2>
    </div>

    <p class="text-sm text-muted-light dark:text-muted-dark">
      Feel free to reach out for collaborations, questions, or just to say hello.
    </p>

    <div class="grid grid-cols-1 sm:grid-cols-2 gap-3 pt-2">
      <a
        href={personalInfo.socials.email}
        class="group flex items-center justify-between p-4 rounded-xl border border-border-light dark:border-border-dark bg-surface-light/40 dark:bg-surface-dark/40 hover:bg-surface-light dark:hover:bg-surface-dark hover:border-gray-400 dark:hover:border-gray-600 transition-all"
      >
        <div class="flex items-center gap-3">
          <svg class="w-4 h-4 text-muted-light dark:text-muted-dark group-hover:text-primary-light dark:group-hover:text-primary-dark transition-colors" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <rect width="20" height="16" x="2" y="4" rx="2"></rect>
            <path d="m22 7-8.97 5.7a1.94 1.94 0 0 1-2.06 0L1 7"></path>
          </svg>
          <span class="text-sm font-medium text-primary-light dark:text-primary-dark">Email</span>
        </div>
        <span class="text-xs font-mono text-muted-light dark:text-muted-dark group-hover:translate-x-0.5 transition-transform">→</span>
      </a>

      <a
        href={personalInfo.socials.github}
        target="_blank"
        rel="noopener noreferrer"
        class="group flex items-center justify-between p-4 rounded-xl border border-border-light dark:border-border-dark bg-surface-light/40 dark:bg-surface-dark/40 hover:bg-surface-light dark:hover:bg-surface-dark hover:border-gray-400 dark:hover:border-gray-600 transition-all"
      >
        <div class="flex items-center gap-3">
          <svg class="w-4 h-4 text-muted-light dark:text-muted-dark group-hover:text-primary-light dark:group-hover:text-primary-dark transition-colors" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <path d="M9 19c-5 1.5-5-2.5-7-3m14 6v-3.87a3.37 3.37 0 0 0-.94-2.61c3.14-.35 6.44-1.54 6.44-7A5.44 5.44 0 0 0 20 4.77 5.07 5.07 0 0 0 19.91 1S18.73.65 16 2.48a13.38 13.38 0 0 0-7 0C6.27.65 5.09 1 5.09 1A5.07 5.07 0 0 0 5 4.77a5.44 5.44 0 0 0-1.5 3.78c0 5.42 3.3 6.61 6.44 7A3.37 3.37 0 0 0 9 18.13V22"></path>
          </svg>
          <span class="text-sm font-medium text-primary-light dark:text-primary-dark">GitHub</span>
        </div>
        <span class="text-xs font-mono text-muted-light dark:text-muted-dark group-hover:translate-x-0.5 transition-transform">↗</span>
      </a>

      <a
        href={personalInfo.socials.twitter}
        target="_blank"
        rel="noopener noreferrer"
        class="group flex items-center justify-between p-4 rounded-xl border border-border-light dark:border-border-dark bg-surface-light/40 dark:bg-surface-dark/40 hover:bg-surface-light dark:hover:bg-surface-dark hover:border-gray-400 dark:hover:border-gray-600 transition-all"
      >
        <div class="flex items-center gap-3">
          <svg class="w-4 h-4 text-muted-light dark:text-muted-dark group-hover:text-primary-light dark:group-hover:text-primary-dark transition-colors" viewBox="0 0 24 24" fill="currentColor">
            <path d="M18.244 2.25h3.308l-7.227 8.26 8.502 11.24H16.17l-5.214-6.817L4.99 21.75H1.68l7.73-8.835L1.254 2.25H8.08l4.713 6.231zm-1.161 17.52h1.833L7.084 4.126H5.117z"/>
          </svg>
          <span class="text-sm font-medium text-primary-light dark:text-primary-dark">X / Twitter</span>
        </div>
        <span class="text-xs font-mono text-muted-light dark:text-muted-dark group-hover:translate-x-0.5 transition-transform">↗</span>
      </a>

      <a
        href={personalInfo.socials.linkedin}
        target="_blank"
        rel="noopener noreferrer"
        class="group flex items-center justify-between p-4 rounded-xl border border-border-light dark:border-border-dark bg-surface-light/40 dark:bg-surface-dark/40 hover:bg-surface-light dark:hover:bg-surface-dark hover:border-gray-400 dark:hover:border-gray-600 transition-all"
      >
        <div class="flex items-center gap-3">
          <svg class="w-4 h-4 text-muted-light dark:text-muted-dark group-hover:text-primary-light dark:group-hover:text-primary-dark transition-colors" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <path d="M16 8a6 6 0 0 1 6 6v7h-4v-7a2 2 0 0 0-2-2 2 2 0 0 0-2 2v7h-4v-7a6 6 0 0 1 6-6z"></path>
            <rect width="4" height="12" x="2" y="9"></rect>
            <circle cx="4" cy="4" r="2"></circle>
          </svg>
          <span class="text-sm font-medium text-primary-light dark:text-primary-dark">LinkedIn</span>
        </div>
        <span class="text-xs font-mono text-muted-light dark:text-muted-dark group-hover:translate-x-0.5 transition-transform">↗</span>
      </a>
    </div>
  </section>
</BaseLayout>
