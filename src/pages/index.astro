---
import BaseLayout from '../layouts/BaseLayout.astro';
import ArrowUpRight from '../components/ArrowUpRight.astro';
import { personalInfo } from '../data/projects';
const interests = [
  { number: '01', title: 'Distributed systems', detail: 'Thinking beyond a single machine.' },
  { number: '02', title: 'Web architecture', detail: 'Fast, efficient, and thoughtfully built.' },
  { number: '03', title: 'Developer tooling', detail: 'Focused tools that make work simpler.' },
];
---

<BaseLayout>
  <section class="hero" aria-labelledby="intro-title">
    <h1 id="intro-title">Mark Okedoyin<span class="name-period">.</span></h1>
    <div class="hero-bottom">
      <div class="intro">
        <p class="eyebrow role">{personalInfo.title}</p>
        <p class="intro-copy">I build software with a focus on simplicity, performance, and clean design.</p>
        <a class="contact-button" href={personalInfo.socials.email}>Let’s talk <ArrowUpRight class="link-arrow" /></a>
      </div>
    </div>
    <div class="hero-foot"><span><i class="status-dot"></i>Available to collaborate</span></div>
  </section>

  <section id="about" class="focus-section" aria-labelledby="focus-title">
    <div class="section-heading"><p class="eyebrow"><span class="section-index">01 /</span> Currently exploring</p><h2 id="focus-title">Always a work in progress.</h2><p>{personalInfo.currentlyLearning}</p></div>
    <div class="interest-grid">
      {interests.map((interest, index) => (
        <article class="interest">
          <div class="interest-top"><span class="eyebrow">{interest.number}</span><svg viewBox="0 0 48 48" fill="none" stroke="currentColor" stroke-width="1.3" aria-hidden="true">
            {index === 0 ? <><rect x="18" y="3" width="12" height="12" /><rect x="3" y="33" width="12" height="12" /><rect x="33" y="33" width="12" height="12" /><path d="M24 15v9H9v9m15-9h15v9" /></> : index === 1 ? <><rect x="5" y="7" width="38" height="34" rx="2" /><path d="M5 17h38M18 17v24M10 12h2m3 0h2m3 0h2" /></> : <><path d="m17 13-11 11 11 11m14-22 11 11-11 11M27 7l-6 34" /></>}
          </svg></div>
          <h3>{interest.title}</h3><p>{interest.detail}</p>
        </article>
      ))}
    </div>
  </section>

  <section id="connect" class="connect-section" aria-labelledby="connect-title">
    <div><p class="eyebrow"><span class="section-index">02 /</span> Get in touch</p><h2 id="connect-title">Good things start<br />with a <em>conversation.</em></h2><p>A collaboration, a question, or just a hello.<br />My inbox is open.</p></div>
    <div class="contact-links"><a href={personalInfo.socials.email}><span><small>Email me</small>{personalInfo.socials.email.replace('mailto:', '')}</span><ArrowUpRight class="link-arrow" /></a><a href={personalInfo.socials.github} target="_blank" rel="noopener noreferrer"><span><small>Find me on GitHub</small>nxemark</span><ArrowUpRight class="link-arrow" /><span class="sr-only"> (opens in a new tab)</span></a></div>
  </section>
</BaseLayout>
